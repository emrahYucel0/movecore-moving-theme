# Private server-only Core CMS Public HTTP configuration.
# Never expose these values through runtimeConfig.public or NUXT_PUBLIC_*.
NUXT_CORE_BASE_URL=http://127.0.0.1:3000
NUXT_CORE_REQUEST_TIMEOUT_MS=5000
NUXT_CORE_PRIMARY_NAVIGATION_ID=
NUXT_CORE_SITE_SETTING_NAMESPACE=
NUXT_CORE_SITE_SETTING_KEY=
NUXT_CORE_FOUNDATION_MEDIA_ID=

# Public website origin used for absolute canonical and sitemap URLs.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
