# Required private, server-only Core CMS Public HTTP connection.
# Never expose this backend origin through runtimeConfig.public or NUXT_PUBLIC_*.
NUXT_CORE_BASE_URL=http://127.0.0.1:4000
NUXT_CORE_REQUEST_TIMEOUT_MS=5000

# Required private shell selectors. The footer selector may be blank to reuse primary navigation.
NUXT_CORE_PRIMARY_NAVIGATION_ID=
NUXT_CORE_FOOTER_NAVIGATION_ID=
NUXT_CORE_SITE_SETTING_NAMESPACE=moving
NUXT_CORE_SITE_SETTING_KEY=business

# Required private submission secrets. Generate independent random values with at least 32 bytes,
# encode as base64url, and never expose them through NUXT_PUBLIC_* or commit real values.
# The upstream value must exactly match Core's CORE_CMS_SUBMISSION_UPSTREAM_SECRET.
NUXT_MOVING_SUBMISSION_CLIENT_IDENTITY_SECRET=
NUXT_CORE_SUBMISSION_UPSTREAM_SECRET=

# Configure these absolute application-manifest paths on the separate Core runtime,
# not as Nuxt runtime configuration. They are public deployment metadata, not secrets.
# CORE_CMS_EDITOR_PROFILES_FILE=C:\absolute\path\application\editor-profiles.json
# CORE_CMS_SETTING_DEFINITIONS_FILE=C:\absolute\path\application\setting-definitions.json
# CORE_CMS_SUBMISSION_DEFINITIONS_FILE=C:\absolute\path\application\submission-definitions.json
# CORE_CMS_SUBMISSION_PRESENTATIONS_FILE=C:\absolute\path\application\submission-presentations.json

# Required public website origin for absolute canonical and sitemap URLs.
# This value is intentionally browser-visible and is not the Core backend origin.
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
